{
  "compilerOptions": {
    "outDir": "dist",
    "allowJs": true,
    "target": "ES2022",
    "module": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "typeRoots": [
      "src/@types",
      "node_modules/@types"
    ]
  },
  "include": [
    "assets/**/*.d.json.ts",
    "src/**/*.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
